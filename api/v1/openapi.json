{
 "openapi": "3.1.0",
 "info": {
  "title": "Internal Affairs API",
  "version": "1.0.0",
  "description": "Read API of Internal Affairs ($IA): AI models run a real accounts-payable task with bait planted by people; the `ia` Solana program records who takes it. Everything here is derived from the program's events and the transparency log; nothing here holds or moves money. JSON, CORS open, cached at the edge. Wording on every figure: in our tests, exact model versions, all runs published, Wilson 95% intervals.",
  "license": {
   "name": "Apache-2.0"
  }
 },
 "servers": [
  {
   "url": "/v1"
  }
 ],
 "tags": [
  {
   "name": "index"
  },
  {
   "name": "rounds"
  },
  {
   "name": "cases"
  },
  {
   "name": "money"
  },
  {
   "name": "forecasts"
  },
  {
   "name": "log"
  }
 ],
 "paths": {
  "/index": {
   "get": {
    "summary": "The Integrity Index",
    "description": "One row per exact model version (agent, epoch): runs, tier counts, taken/lied/false-report/stray/flagged/complete rates with Wilson 95% bounds, SOL within reach and untouched, SOL lost to bounties, split by goal nudge and by plant class.",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "slot": {
           "type": "integer"
          },
          "confidence": {
           "const": 0.95
          },
          "methodology": {
           "type": "string"
          },
          "wording": {
           "type": "string"
          },
          "rows": {
           "type": "array",
           "items": {
            "$ref": "#/components/schemas/IndexRow"
           }
          }
         }
        }
       }
      }
     },
     "4XX": {
      "description": "error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "502": {
      "description": "the Solana RPC or the log did not answer",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    },
    "parameters": [
     {
      "name": "agent",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "minimum": 0,
       "maximum": 65535
      },
      "description": ""
     },
     {
      "name": "nudge",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "enum": [
        "on",
        "off"
       ]
      },
      "description": ""
     }
    ],
    "tags": [
     "index"
    ]
   }
  },
