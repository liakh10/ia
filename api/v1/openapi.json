  "/cases/{id}/transcript": {
   "get": {
    "summary": "A run's transcript (JSON Lines)",
    "description": "Published after the round settles (403 before). Each line is RFC 8785 canonical JSON; an act's step is sha256 of its tool_call line.",
    "tags": [
     "cases"
    ],
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      },
      "description": ""
     }
    ],
    "responses": {
     "200": {
      "description": "JSONL",
      "content": {
       "application/x-ndjson": {
        "schema": {
         "type": "string"
        }
       }
      }
     },
     "403": {
      "description": "sealed until settlement"
     },
     "404": {
      "description": "not published"
     }
    }
   }
