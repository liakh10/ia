 "components": {
  "schemas": {
   "Rate": {
    "type": "object",
    "properties": {
     "k": {
      "type": "integer"
     },
     "n": {
      "type": "integer"
     },
     "rate": {
      "type": [
       "number",
       "null"
      ]
     },
     "low": {
      "type": [
       "number",
       "null"
      ],
      "description": "Wilson 95% lower bound"
     },
     "high": {
      "type": [
       "number",
       "null"
      ],
      "description": "Wilson 95% upper bound"
     }
    },
    "required": [
     "k",
     "n",
     "rate",
     "low",
     "high"
    ]
   },
   "Stats": {
    "type": "object",
    "properties": {
     "runs": {
      "type": "integer",
      "description": "settled runs that are not VOID"
     },
     "rounds": {
      "type": "integer"
     },
     "voidRuns": {
      "type": "integer"
     },
     "tiers": {
      "type": "object",
      "additionalProperties": {
       "type": "integer"
      }
     },
     "rates": {
      "type": "object",
      "properties": {
       "taken": {
        "$ref": "#/components/schemas/Rate"
       },
       "lied": {
        "$ref": "#/components/schemas/Rate"
       },
       "falseReport": {
        "$ref": "#/components/schemas/Rate"
       },
       "stray": {
        "$ref": "#/components/schemas/Rate"
       },
       "flagged": {
        "$ref": "#/components/schemas/Rate"
       },
       "complete": {
        "$ref": "#/components/schemas/Rate"
       }
      }
     },
     "liedGivenTaken": {
      "$ref": "#/components/schemas/Rate"
     },
     "untouchedLamports": {
      "type": "string",
      "pattern": "^[0-9]+$",
      "description": "lamports (decimal string: u64 does not fit a JSON number)"
     },
     "untouchedSol": {
      "type": "string"
     },
     "lostLamports": {
      "type": "string",
      "pattern": "^[0-9]+$",
      "description": "lamports (decimal string: u64 does not fit a JSON number)"
     },
     "lostSol": {
      "type": "string"
     },
     "byClass": {
      "type": "object",
      "additionalProperties": {
       "type": "object",
       "properties": {
        "exposures": {
         "type": "integer"
        },
        "taken": {
         "type": "integer"
        },
        "rate": {
         "$ref": "#/components/schemas/Rate"
        }
       }
      }
     }
    }
   },
   "IndexRow": {
    "allOf": [
     {
      "$ref": "#/components/schemas/Stats"
     },
     {
      "type": "object",
      "properties": {
       "agent": {
        "type": "integer"
       },
       "kind": {
        "type": "string",
        "enum": [
         "house",
         "open_league"
        ]
       },
       "epoch": {
        "type": "integer",
        "description": "bumped on every model version change"
       },
       "model": {
        "type": "string",
        "description": "the exact model version string recorded on chain"
       },
       "firstRound": {
        "type": "string"
       },
       "lastRound": {
        "type": "string"
       },
       "nudge": {
        "type": "object",
        "properties": {
         "on": {
          "$ref": "#/components/schemas/Stats"
         },
         "off": {
          "$ref": "#/components/schemas/Stats"
         }
        }
       }
      }
     }
    ]
   },
   "Error": {
    "type": "object",
    "properties": {
