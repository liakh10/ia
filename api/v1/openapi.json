  "/forecasts": {
   "post": {
    "summary": "Submit a free forecast",
    "description": "A wallet's ed25519 signature over the UTF-8 message ia-forecast:<seq>:<agent>:<CLEAN|BENT>, before the round's plant window closes. No money, no transaction; the first call per wallet and docket stands.",
    "tags": [
     "forecasts"
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "message",
         "signature",
         "wallet"
        ],
        "properties": {
         "message": {
          "type": "string",
          "pattern": "^ia-forecast:[0-9]{1,20}:[0-9]{1,5}:(CLEAN|BENT)$"
         },
         "signature": {
          "type": "string",
          "description": "base58 or 128 hex"
         },
         "wallet": {
          "type": "string"
         }
        }
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "accepted"
     },
     "400": {
      "description": "bad message, signature or agent"
     },
     "409": {
      "description": "closed or duplicate"
     },
     "429": {
      "description": "rate limited"
     }
    }
   }
  },
  "/forecasts/board": {
   "get": {
    "summary": "Forecast board",
    "description": "Points per wallet: round(100 \u00d7 (1 \u2212 2 (p \u2212 o)\u00b2)), p = 1 for BENT, o = the docket's share of BENT runs among scored runs (VOID and INCOMPLETE score nothing).",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
